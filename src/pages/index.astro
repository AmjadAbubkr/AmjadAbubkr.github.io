---
const languageLinks = [
  { locale: "fr", label: "Français" },
  { locale: "ar", label: "العربية" },
  { locale: "en", label: "English" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#323544" />
    <title>Amdjad Aboubakar</title>
    <script is:inline>
      (() => {
        const supported = new Set(["fr", "ar", "en"]);
        let saved = null;
        try { saved = localStorage.getItem("amdjad-portfolio-locale"); } catch {}
        const languages = navigator.languages?.length ? navigator.languages : [navigator.language];
        const preferred = supported.has(saved)
          ? saved
          : languages.map((item) => item?.toLowerCase().split("-")[0]).find((item) => supported.has(item)) ?? "fr";
        location.replace(`/${preferred}/`);
      })();
    </script>
    <style>
      :root { font-family: "Segoe UI", Tahoma, Arial, sans-serif; color-scheme: dark; }
      * { box-sizing: border-box; }
      body { display: grid; min-height: 100vh; margin: 0; padding: 2rem; place-items: center; background: #323544; color: #f5f5f7; }
      main { width: min(100%, 46rem); }
      span { display: grid; width: 3rem; height: 3rem; margin-block-end: 2rem; place-items: center; background: #ffae21; color: #232733; font-weight: 800; }
      h1 { margin: 0 0 1rem; font-size: clamp(3rem, 10vw, 7rem); letter-spacing: -0.07em; line-height: 0.9; text-wrap: balance; }
      p { max-width: 35rem; color: #b7bac4; }
      nav { display: flex; margin-block-start: 2rem; flex-wrap: wrap; gap: 0.75rem; }
      a { display: grid; min-width: 7rem; min-height: 48px; padding: 0.5rem 1rem; place-items: center; color: inherit; text-decoration: none; box-shadow: 0 0 0 1px rgba(255,255,255,.12); }
      a:hover, a:focus-visible { color: #ffae21; box-shadow: 0 0 0 1px rgba(255,174,33,.6); }
      a:focus-visible { outline: 2px solid #ffae21; outline-offset: 4px; }
    </style>
  </head>
  <body>
    <main>
      <span aria-hidden="true">AA</span>
      <h1>Amdjad Aboubakar</h1>
      <p>Choisissez une langue si la détection automatique ne vous redirige pas.</p>
      <nav aria-label="Language">
        {languageLinks.map((item) => <a href={`/${item.locale}/`} lang={item.locale}>{item.label}</a>)}
      </nav>
    </main>
  </body>
</html>
