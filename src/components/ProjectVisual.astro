---
import type { ProjectSlug } from "@/data/types";

interface Props {
  slug: ProjectSlug;
}

const { slug } = Astro.props;
const covers: Record<ProjectSlug, string> = {
  khidme: "/images/khidme-cover.webp",
  khalawat: "/images/khalawat-cover.webp",
  "meeting-app": "/images/meeting-app-cover.webp",
  hamid: "/images/hamid-cover.webp",
  "game-technologie": "/images/game-technologie-cover.png",
};
---

<figure class:list={["project-visual", `project-visual--${slug}`]}>
  <img src={covers[slug]} alt="" loading="lazy" decoding="async" />
</figure>
